# Copiar como .env y completar. .env no se sube a Git.
DB_URL=jdbc:postgresql://<host-de-supabase>:5432/postgres?sslmode=require
DB_USER=postgres
DB_PASSWORD=cambiar
# false para probar en local sin token
SEGURIDAD_HABILITADA=false
# true mientras Productos (F), Despacho (E) y Seguridad (G) no existan
INTEGRACION_SIMULADA=true
# true: PasarelaClient (M1 cobros de 1.1, M2 extornos) solo deja un log. false: llama al simulador-pasarela
PASARELA_SIMULADA=true
# true: M1 no llama a M2 (reembolsos y eventos quedan guardados y se envían al pasar a false). Si falta, usa INTEGRACION_SIMULADA
POSTVENTA_SIMULADO=true
# true: "paquete sellado" no llama a Despacho (G2). Si falta, usa INTEGRACION_SIMULADA
DESPACHO_SIMULADO=true
# Seguridad (G7): emisor exacto y JWKS. Valores del kit de integración, sección 2.
# En nube: las URLs HTTPS que publique Seguridad.
SECURITY_ISSUER=http://localhost:8080/api/v1/auth
SECURITY_JWKS_URL=http://localhost:8080/api/v1/auth/.well-known/jwks.json
# Token de servicio de M1 (client_credentials) para llamar a M2, Productos y Despacho.
# En local: modulo-ventas / secreto-de-prueba. El secreto real lo da Seguridad por privado (Hito 4). Vacío: sin token
SECURITY_TOKEN_URL=http://localhost:8080/api/v1/auth/token
SECURITY_CLIENT_ID=modulo-ventas
SECURITY_CLIENT_SECRET=
# M2 (modulo-postventa) para llamar a M1 (1.3)
POSTVENTA_CLIENT_ID=modulo-postventa
POSTVENTA_CLIENT_SECRET=secreto-de-prueba
# M2: evidencias de devolución (F3, 2.1). local: carpeta del disco; supabase: Supabase Storage
EVIDENCIAS_ALMACEN=local
EVIDENCIAS_CARPETA=uploads/evidencias
EVIDENCIAS_URL_LOCAL=http://localhost:8082/uploads/evidencias
EVIDENCIAS_BUCKET=evidencias
# Solo con EVIDENCIAS_ALMACEN=supabase. La service key va solo en el .env, nunca en el repo
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Orígenes permitidos por CORS (frontends de Marketplace, Chatbot, consola), separados por coma
CORS_ORIGINS=http://localhost:5173
# Solo con SEGURIDAD_HABILITADA=false: cliente que usa /pedidos/me (cliente activo del kit de Seguridad)
CLIENTE_PRUEBA=11111111-1111-1111-1111-111111111111
# URLs entre aplicaciones
VENTAS_URL=http://localhost:8081
POSTVENTA_URL=http://localhost:8082
PASARELA_URL=http://localhost:8083
# Módulo F (G6): reserva de stock en 1.1. Solo se usa con INTEGRACION_SIMULADA=false
PRODUCTOS_URL=http://localhost:8090
# M2: location_id del almacén de devoluciones para el reintegro (G6, P-04). Pendiente de G6: dejar vacío
PRODUCTOS_UBICACION_DEVOLUCIONES=
# Módulo E (G2): crear despacho. URL que publique Despacho
DESPACHO_URL=http://localhost:8092
# RabbitMQ de Productos (G6), vhost g6-productos-ofertas (su AsyncAPI). Solo con INTEGRACION_SIMULADA=false. La contraseña la pasa Productos por privado
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=cambiar
RABBITMQ_VHOST=g6-productos-ofertas

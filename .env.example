# Copiar como .env y completar. .env no se sube a Git.
DB_URL=jdbc:postgresql://<host-de-supabase>:5432/postgres?sslmode=require
DB_USER=postgres
DB_PASSWORD=cambiar
# false para probar en local sin token
SEGURIDAD_HABILITADA=false
# true mientras los otros módulos no existan
INTEGRACION_SIMULADA=true
# JWKS del Módulo G (solo si SEGURIDAD_HABILITADA=true)
JWT_JWK_SET_URI=http://localhost:9000/.well-known/jwks.json
# URLs que usa el gateway y M2 para llamar a M1
VENTAS_URL=http://localhost:8081
POSTVENTA_URL=http://localhost:8082
